# Cloud sync (Worker + D1) — leave empty for local-only mode.
# Local worker:  VITE_API_URL=http://localhost:8787
# Production:    VITE_API_URL=https://shs-evaluation-api.<your-subdomain>.workers.dev
VITE_API_URL=
# Must match the worker's API_TOKEN secret (if set). Set via:
#   pnpm exec wrangler secret put API_TOKEN
VITE_API_TOKEN=
